# Configuração AWS
aws_region = "us-east-1"
project_name = "financial-batch-processor"
environment = "dev"

# Configuração S3
# Nota: nomes de buckets S3 devem ser globalmente únicos
# Altere o sufixo para algo único
s3_transactions_bucket_name = "financial-transactions-dev-12345"
s3_glue_scripts_bucket_name = "glue-scripts-dev-12345"

# Configuração DynamoDB
dynamodb_table_name = "customer-registration-dev"
dynamodb_billing_mode = "PAY_PER_REQUEST"  # ou "PROVISIONED"
# Se usar modo PROVISIONED:
# dynamodb_read_capacity = 5
# dynamodb_write_capacity = 5

# Configuração OpenSearch
opensearch_domain_name = "financial-txns-dev"
opensearch_version = "OpenSearch_2.11"
opensearch_instance_type = "t3.small.search"  # Use t3.small para dev, r6g.large para prod
opensearch_instance_count = 1  # Use 3 para produção com HA
opensearch_ebs_volume_size = 10  # GB
opensearch_ebs_volume_type = "gp3"

# Acesso OpenSearch (para domínio público)
# Adicione seu endereço IP para acesso
opensearch_allowed_ips = ["0.0.0.0/0"]  # AVISO: Altere para seu IP em produção

# Configuração do job Glue
glue_job_name = "financial-transaction-processor"
glue_version = "4.0"  # ou "5.0"
glue_worker_type = "G.1X"  # G.1X (8GB) ou G.2X (16GB)
glue_number_of_workers = 2
glue_max_retries = 1
glue_timeout_minutes = 60

# Opcional: Configuração VPC (descomente para implantação em VPC)
# vpc_id = "vpc-xxxxx"
# private_subnet_ids = ["subnet-xxxxx", "subnet-yyyyy"]
# security_group_ids = ["sg-xxxxx"]

# Tags
tags = {
  Project     = "FinancialBatchProcessor"
  Environment = "Development"
  ManagedBy   = "Terraform"
  Owner       = "YourName"
  CostCenter  = "Engineering"
}
